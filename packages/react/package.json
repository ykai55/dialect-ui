    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bash ../../tools/test-fixture.sh react"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@dialect-ui/core": "^0.1.0"
  }
